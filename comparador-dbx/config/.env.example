# ============================================================================================
# EJEMPLO para crear tu `config/.env`. El programa NO lee este archivo; solo es una guía.
#   cp config/.env.example config/.env      (y rellena lo que corresponda a tu stage)
#
# `config/.env` es SOLO lo tuyo y lo secreto (no se versiona). Todo lo demás ya viene de:
#   config/stages/<STAGE>.env   proveedores y modelos de cada stage (versionado)
#   config/defaults.env         valores por defecto de todas las variables (versionado)
# Orden de prioridad: variable de entorno > config/.env > stages/<STAGE>.env > defaults.env
# ============================================================================================

# --- Siempre: el stage -------------------------------------------------------------------
STAGE=sandbox                    # dev (MacBook + Docker Model Runner) | sandbox (Raspberry) | mvp (Databricks + Foundry)

# --- Normas (todos los stages) ---------------------------------------------------------------
# Los PDF de las normas se leen de comparador-dbx/documentos/normas/ (no se versionan). Otra ruta:
# NORMAS_DIR=/ruta/completa/a/mis/normas
# Los manuales (MOCK) se leen de comparador-dbx/documentos/manuales/ (van en git). Otra ruta:
# MANUALES_DIR=/ruta/completa/a/mis/manuales

# --- STAGE=dev ----------------------------------------------------------------------------
# No necesita secretos: DMR corre local. Opcional, si tu equipo es lento:
# LLM_TIMEOUT_S=600
# DMR_LLM_MODEL=ai/gemma4        # alternativa más ligera a ai/qwen3.5:9B-UD-Q4_K_XL

# --- STAGE=sandbox ------------------------------------------------------------------------
# Clave de Groq (secreto). Pégala justo después del "=", sin comentarios en la misma línea.
GROQ_API_KEY=
# Embeddings con Ollama local (bge-m3); no necesita clave.

# --- STAGE=mvp (llevar a Databricks) --------------------------------------------------------
# NO se ponen en este archivo. En Databricks se entregan así:
#
#   Notebooks (antes de importar `backend`; está en la celda de arranque comentada de cada notebook):
#     os.environ["STAGE"] = "mvp"
#     os.environ["FOUNDRY_AI_TOKEN"] = dbutils.secrets.get(scope="<scope>", key="foundry_ai_token")
#     os.environ["FOUNDRY_AI_ENDPOINT"] = "https://<recurso>.openai.azure.com"
#     os.environ["FOUNDRY_AI_API_VERSION"] = "<versión>"
#     os.environ["FOUNDRY_AI_DEPLOYMENT"] = "<deployment del LLM>"
#     os.environ["FOUNDRY_AI_EMBED_DEPLOYMENT"] = "<deployment de embeddings>"
#
#   Apps (app.yaml): el token con `valueFrom: foundry_ai_token` (recurso secret de la app) y el
#   resto como `env` normal. El `command` de app.yaml no pasa por shell.
#
# Prueba local contra Foundry (solo si quieres probar mvp en tu máquina):
# STAGE=mvp
# FOUNDRY_AI_TOKEN=
# FOUNDRY_AI_ENDPOINT=
# FOUNDRY_AI_API_VERSION=
# FOUNDRY_AI_DEPLOYMENT=
# FOUNDRY_AI_EMBED_DEPLOYMENT=
