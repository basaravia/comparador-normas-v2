# --- Stage (docs/14 #13): elige config/stages/<STAGE>.env con proveedores y modelos ---
#   dev     -> MacBook con Docker Model Runner (LLM y embeddings)
#   sandbox -> Raspberry Pi: Groq + Ollama bge-m3
#   mvp     -> cluster Databricks: Azure AI Foundry
# Se define en config/.env (local) o como variable de entorno. Sin STAGE valen los de abajo.
STAGE=

# --- Modelos: proveedor por configuración (docs/14 #14) ---
LLM_PROVIDER=groq            # groq | foundry | ollama | dmr
EMB_PROVIDER=ollama          # ollama | foundry | dmr

# Groq (LLM de desarrollo; clave gratuita en console.groq.com)
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama (embeddings locales de desarrollo)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_EMB_MODEL=bge-m3
# solo si LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=

# Docker Model Runner (alternativa local a Ollama; API compatible con OpenAI).
# Desde el host: localhost:12434. Desde un contenedor: http://model-runner.docker.internal/engines/v1
DMR_BASE_URL=http://localhost:12434/engines/v1
# lo fija config/stages/dev.env
DMR_LLM_MODEL=
# lo fija config/stages/dev.env
DMR_EMB_MODEL=

# Azure AI Foundry (demo). El token es secreto: en Databricks va como recurso secret (valueFrom).
FOUNDRY_AI_ENDPOINT=
FOUNDRY_AI_API_VERSION=
FOUNDRY_AI_TOKEN=
# GPT-5.6
FOUNDRY_AI_DEPLOYMENT=
# text-embedding-3-large
FOUNDRY_AI_EMBED_DEPLOYMENT=
FOUNDRY_OMIT_TEMPERATURE=true # GPT-5.x (razonamiento) solo acepta la temperatura de fábrica
# En Databricks el token NO va aquí: notebooks -> dbutils.secrets.get (línea comentada en
# cada notebook); Apps -> app.yaml con `valueFrom: foundry_ai_token`.

# Parámetros comunes del LLM
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=120

# --- Límites de ingesta ---
MAX_PAGES=250                # RF-04 (usuario, 12 oct 2026): antes 100
MAX_MB=20
SCAN_TEXT_RATIO=0.6          # [CALIBRAR]
TYPE_CONFIDENCE=0.75         # [CALIBRAR]

# --- Extracción ---
# Zona de documentos (decisión del usuario, 12 oct 2026): test = MOCK y normas públicas (se versiona lo de test);
# val = documentos reales de validación (NUNCA se versionan: ni documentos/val/ ni output/val/).
DOCS_ZONA=test
MANUALES_DIR=                # vacío = documentos/<zona>/manuales. Una ruta (relativa a comparador-dbx/ o absoluta) gana sobre la zona
# Alertas de exclusión (docs/14 #24): si lo excluido por reglas es mucho, el auditor debe confirmarlo antes de comparar
EXCLUSION_MAX_PCT=25
EXCLUSION_MAX_HEREDADAS=10
NORMAS_DIR=                  # vacío = documentos/<zona>/normas. Una ruta (relativa a comparador-dbx/ o absoluta) gana sobre la zona
# vacío: Docling descarga sus modelos al primer uso
DOCLING_ARTIFACTS=
# true: una tabla es una sola unidad al trocear (si no cabe, se parte por filas repitiendo la cabecera) y las tablas que
# continúan en la página siguiente se unen. false: método anterior (una fila por línea, tablas partidas por página)
TABLAS_ATOMICAS=true
# auto = usa la GPU si hay (NVIDIA CUDA, Apple Metal/MPS, AMD ROCm) y si no, la CPU. Fuerza con cpu | cuda | mps
DOCLING_DEVICE=auto
DOCLING_THREADS=2            # [CALIBRAR] según núcleos del cómputo Medium
DOCLING_TABLES=fast          # [CALIBRAR] fast | off | accurate (medido en la Pi: fast +50 % de tiempo, off pierde la estructura)
DOCLING_TIMEOUT_S=3600       # [CALIBRAR] por documento; docling 2.134 en la Pi con 2 CPU: ~9,3 s/página (250 págs ≈ 39 min; con GPU, mucho menos)
DOCLING_CHUNK_PAGES=10       # [CALIBRAR] páginas por tanda: acota la RAM y da el progreso
OMP_NUM_THREADS=2

# --- Seccionado (docs/07 §2) ---
SECCION_CHARS=1200           # [CALIBRAR] nivel 3 (longitud): caracteres por bloque, respetando párrafos
SECCION_BLOQUE_MAX=200000    # tope de caracteres de un solo bloque de texto; más es entrada anómala (ERR-SEC-001)

# --- Indexación ---
SUBCHUNK_TOKENS=500          # [CALIBRAR]
SUBCHUNK_OVERLAP=0.15        # [CALIBRAR]
EMB_BATCH=64                 # [CALIBRAR]

# --- Recuperación ---
K_SUBCHUNKS=10               # [CALIBRAR]
SIM_THRESHOLD=0.30           # [CALIBRAR] distinto por modelo de embeddings: cada stage lo fija en config/stages/<STAGE>.env
MIN_FLOOR=3
MAX_CANDIDATES=10

# --- Reranker (opcional, apagado por defecto; docs/08 §Reranking, docs/14 #25) ---
RERANK_ENABLED=false         # true: las dos vías toman el top-N denso y el reranker se queda con los MAX_CANDIDATES mejores
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B   # alternativa: BAAI/bge-reranker-v2-m3 (se elige la familia por el nombre)
RERANK_TOP_N=20              # [CALIBRAR] candidatos densos que entran al reranker (debe ser >= MAX_CANDIDATES)
RERANK_DEVICE=auto           # auto (cuda > mps > cpu) | cpu | mps | cuda
RERANK_BATCH=2               # [CALIBRAR] pares por lote (RAM)

# --- Juez ---
LLM_CONCURRENCY=6            # [CALIBRAR]
LLM_RETRIES=3
CITATION_FUZZY_MIN=0.90      # [CALIBRAR]
CITATION_SHOW_MIN=0.75       # debajo: celda vacía con aviso (docs/14 #11)

# --- Sesión ---
SESSION_TTL_HOURS=4

# --- Papel de trabajo (verde y blanco hasta el brand kit) ---
COLOR_PRIMARIO=1E7B4F
COLOR_FONDO=FFFFFF
