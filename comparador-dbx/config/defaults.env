# --- Stage (docs/14 #13): elige config/stages/<STAGE>.env con proveedores y modelos ---
#   dev     -> MacBook con Docker Model Runner (LLM y embeddings)
#   sandbox -> Raspberry Pi: Groq + Ollama bge-m3
#   mvp     -> cluster Databricks: Azure AI Foundry
# Se define en config/.env (local) o como variable de entorno. Sin STAGE valen los de abajo.
STAGE=

# --- Modelos: proveedor por configuración (docs/14 #14) ---
LLM_PROVIDER=groq            # groq | foundry | ollama | dmr
EMB_PROVIDER=ollama          # ollama | foundry | dmr

# Groq (LLM de desarrollo; clave gratuita en console.groq.com)
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama (embeddings locales de desarrollo)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_EMB_MODEL=bge-m3
# solo si LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=

# Docker Model Runner (alternativa local a Ollama; API compatible con OpenAI).
# Desde el host: localhost:12434. Desde un contenedor: http://model-runner.docker.internal/engines/v1
DMR_BASE_URL=http://localhost:12434/engines/v1
# lo fija config/stages/dev.env
DMR_LLM_MODEL=
# lo fija config/stages/dev.env
DMR_EMB_MODEL=

# Azure AI Foundry (demo). El token es secreto: en Databricks va como recurso secret (valueFrom).
FOUNDRY_AI_ENDPOINT=
FOUNDRY_AI_API_VERSION=
FOUNDRY_AI_TOKEN=
# GPT-5.6
FOUNDRY_AI_DEPLOYMENT=
# text-embedding-3-large
FOUNDRY_AI_EMBED_DEPLOYMENT=
FOUNDRY_OMIT_TEMPERATURE=true # GPT-5.x (razonamiento) solo acepta la temperatura de fábrica
# En Databricks el token NO va aquí: notebooks -> dbutils.secrets.get (línea comentada en
# cada notebook); Apps -> app.yaml con `valueFrom: foundry_ai_token`.

# Parámetros comunes del LLM
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=120

# --- Límites de ingesta ---
MAX_PAGES=250        # límite duro por PDF (RF-04; docs/14 #36). Con DOCLING_TIMEOUT_S: ~9,3 s/página en la Pi
MAX_MB=20
SCAN_TEXT_RATIO=0.6          # [CALIBRAR]
TYPE_CONFIDENCE=0.75         # [CALIBRAR]

# --- Extracción ---
MANUALES_DIR=documentos/manuales   # manuales de control (los MOCK ficticios van en git). Relativa a comparador-dbx/ o absoluta
# Alertas de exclusión (docs/14 #24): si lo excluido por reglas es mucho, el auditor debe confirmarlo antes de comparar
EXCLUSION_MAX_PCT=25
EXCLUSION_MAX_HEREDADAS=10
NORMAS_DIR=documentos/normas   # PDFs de normas, fuera de git. Ruta relativa a comparador-dbx/ o absoluta
# vacío: Docling descarga sus modelos al primer uso
DOCLING_ARTIFACTS=
# true: una tabla es una sola unidad al trocear (si no cabe, se parte por filas repitiendo la cabecera) y las tablas que
# continúan en la página siguiente se unen. false: método anterior (una fila por línea, tablas partidas por página)
TABLAS_ATOMICAS=true
# auto = usa la GPU si hay (NVIDIA CUDA, Apple Metal/MPS, AMD ROCm) y si no, la CPU. Fuerza con cpu | cuda | mps
DOCLING_DEVICE=auto
DOCLING_THREADS=2            # [CALIBRAR] según núcleos del cómputo Medium
DOCLING_TABLES=fast          # [CALIBRAR] fast | off | accurate (medido en la Pi: fast +50 % de tiempo, off pierde la estructura)
DOCLING_TIMEOUT_S=3000       # [CALIBRAR] por documento; docling 2.134 en la Pi con 2 CPU: ~9,3 s/página (250 págs ≈ 39 min); subir si cambia MAX_PAGES
DOCLING_CHUNK_PAGES=10       # [CALIBRAR] páginas por tanda: acota la RAM y da el progreso
OMP_NUM_THREADS=2

# --- Seccionado (docs/07 §2) ---
SECCION_CHARS=1200           # [CALIBRAR] nivel 3 (longitud): caracteres por bloque, respetando párrafos
SECCION_BLOQUE_MAX=200000    # tope de caracteres de un solo bloque de texto; más es entrada anómala (ERR-SEC-001)

# --- Indexación ---
SUBCHUNK_TOKENS=500          # [CALIBRAR]
SUBCHUNK_OVERLAP=0.15        # [CALIBRAR]
EMB_BATCH=64                 # [CALIBRAR]

# --- Recuperación ---
K_SUBCHUNKS=10               # [CALIBRAR]
SIM_THRESHOLD=0.30           # [CALIBRAR] distinto por modelo de embeddings: cada stage lo fija en config/stages/<STAGE>.env
MIN_FLOOR=3
MAX_CANDIDATES=10

# --- Juez ---
LLM_CONCURRENCY=6            # [CALIBRAR]
LLM_RETRIES=3
LLM_ESPERA_LIMITE_S=20       # [CALIBRAR] espera base (s) ante un 429 del proveedor; crece con cada intento
LLM_INTENTOS_LIMITE=6        # [CALIBRAR] intentos ante un 429 antes de abortar
CITATION_FUZZY_MIN=0.90      # [CALIBRAR]
CITATION_SHOW_MIN=0.75       # debajo: celda vacía con aviso (docs/14 #11)
MAX_FRAGMENTO_DIFUSO=600     # [CALIBRAR] caracteres: una cita más larga que no es subcadena exacta no se compara difuso (costo cuadrático)

# --- Sesión ---
SESSION_TTL_HOURS=48         # retención por inactividad (docs/14 #37)
MAX_SESIONES=20             # [CALIBRAR] sesiones vivas a la vez (RAM del contenedor); más = 503 con mensaje de negocio
SESION_EXPULSABLE_MIN=120   # [CALIBRAR] con MAX_SESIONES lleno, solo se expulsa la sesión más inactiva si lleva al menos estos minutos sin uso y sin trabajo activo
TRUST_PROXY_IDENTITY=false  # true solo en app.yaml (Databricks): la sesión es del correo de x-forwarded-email; exige DATABRICKS_APP_NAME
LIMPIAR_TMP_AL_ARRANCAR=false  # true solo en app.yaml: al iniciar borra las carpetas de sesión que dejó un proceso anterior en /tmp
MAX_DOCS_SESION=8            # [CALIBRAR] documentos por sesión (RAM del contenedor)
MAX_PAGES_SESION=500         # [CALIBRAR] tope de páginas sumadas de los documentos de una sesión (appsec S-18: con 250 págs por PDF una sesión podía ocupar la cola de Docling ~6,7 h)
MAX_PARES=600                # [CALIBRAR] pares por comparación: más = se pide seleccionar menos (costo y tiempo del juez)
# [CALIBRAR] pares resueltos desde los que la pantalla «Comparando» muestra el tiempo restante estimado (JobOut.estimado_desde_pares)
ESTIMADO_DESDE_PARES=3
# [CALIBRAR] pares resueltos que la pantalla «Comparando» pinta a la vez, antes de «Mostrar más» (JobOut.pares_por_pagina)
PARES_POR_PAGINA=50

# --- Papel de trabajo (verde y blanco hasta el brand kit) ---
COLOR_PRIMARIO=1E7B4F
COLOR_FONDO=FFFFFF
COLOR_MARCA_A=C6EFCE  # [CALIBRAR] relleno suave de la marca A «Sí cumple» (verde); hasta recibir el brand kit del banco
COLOR_MARCA_L=FFEB9C  # [CALIBRAR] relleno suave de la marca L «Parcialmente» (ámbar)
COLOR_MARCA_R=F8CBAD  # [CALIBRAR] relleno suave de la marca R «No cumple» (rojo)
COLOR_MARCA_X=E7E6E6  # [CALIBRAR] relleno suave de la marca X «No aplica» (gris)
COLOR_MARCA_P=DDEBF7  # [CALIBRAR] relleno suave de la marca P «Información de la normativa» (azul)

# Marca / identidad visual (docs/ux/identidad-visual-v1.md §6). Todas opcionales: vacías = solo texto, sin logos.
# Los logos NO van al repo: el servicio de destino copia los archivos a LOGO_DIR (relativa a comparador-dbx/) y aquí se pone la ruta /marca/<archivo>.svg|png.
NOMBRE_PRODUCTO=Comparador Normativo
TEXTO_ALTERNATIVO=
LOGO_DIR=marca
LOGO_ORG_URL=
LOGO_PRODUCTO_URL=
LOGO_PIE_URL=
