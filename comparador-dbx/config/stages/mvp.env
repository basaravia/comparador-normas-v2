# Stage mvp — cluster Databricks con Azure AI Foundry.
# Solo proveedores. NUNCA secretos ni el endpoint real aquí (repo público): el token sale de
# dbutils.secrets.get (notebooks) o de valueFrom en app.yaml (Apps), y el endpoint y los
# deployments se definen como variables de entorno en ese entorno.
LLM_PROVIDER=foundry
EMB_PROVIDER=foundry   # en Databricks no hay Ollama ni DMR
FOUNDRY_OMIT_TEMPERATURE=true
