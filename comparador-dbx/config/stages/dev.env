# Stage dev — MacBook de desarrollo con Docker Desktop (Docker Model Runner).
# Solo proveedores y modelos. NUNCA secretos aquí: este archivo se versiona.
LLM_PROVIDER=dmr
EMB_PROVIDER=dmr
DMR_BASE_URL=http://localhost:12434/engines/v1
DMR_LLM_MODEL=ai/qwen3.5:9B-UD-Q4_K_XL          # alternativa: ai/gemma4
DMR_EMB_MODEL=ai/granite-embedding-multilingual  # alternativa: ai/qwen3-embedding (en tu Mac es la variante de 4B)
# Reranker opcional: RERANK_ENABLED, RERANK_MODEL, RERANK_TOP_N y RERANK_DEVICE (valores por defecto en defaults.env). Se activa en config/.env, no aquí.
