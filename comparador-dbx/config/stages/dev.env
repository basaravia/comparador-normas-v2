# Stage dev — MacBook de desarrollo con Docker Desktop (Docker Model Runner).
# Solo proveedores y modelos. NUNCA secretos aquí: este archivo se versiona.
LLM_PROVIDER=dmr
EMB_PROVIDER=dmr
DMR_BASE_URL=http://localhost:12434/engines/v1
DMR_LLM_MODEL=ai/qwen3.5:9B-UD-Q4_K_XL          # alternativa: ai/gemma4
DMR_EMB_MODEL=ai/granite-embedding-multilingual  # alternativa: ai/qwen3-embedding
