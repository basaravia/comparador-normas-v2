# Stage sandbox — Raspberry Pi. LLM en Groq (clave en config/.env) y embeddings en Ollama.
# Solo proveedores y modelos. NUNCA secretos aquí: este archivo se versiona.
LLM_PROVIDER=groq
EMB_PROVIDER=ollama
GROQ_LLM_MODEL=openai/gpt-oss-120b
OLLAMA_EMB_MODEL=bge-m3
# Umbral calibrado en L3 con bge-m3 sobre el golden set (LA/FT 31-48 vs MOCK): recall@candidatos 93,3 % a 0,50; 96,7 % a 0,30 (0,55 baja a 86,7 %).
SIM_THRESHOLD=0.50
