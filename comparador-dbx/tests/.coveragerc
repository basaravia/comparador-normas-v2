# Configuración de coverage para pytest-cov (la usa pytest.ini).
[run]
data_file = ${TMPDIR-/tmp}/comparador-dbx.coverage

[report]
# docling_worker.main() solo se puede ejercitar con Docling real (sus modelos): lo cubre
# tests/test_integracion_extraccion.py (-m integracion), que no cuenta para el porcentaje (docs/13).
exclude_also =
    def main\(pdf: str
    if __name__ == "__main__":
