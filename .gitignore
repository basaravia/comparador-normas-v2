# Secretos y entornos
.env
*.env
*.pem
*.key
id_*
.claude/settings.local.json

# Python y notebooks
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# Artefactos locales
/output/
# Resultados (zonas, docs/14 #26): output/test/ se versiona (salvo la caché de bloques); output/val/ y lo demás, nunca
/comparador-dbx/output/*
!/comparador-dbx/output/test/
/comparador-dbx/output/test/bloques
/comparador-dbx/output/val/
*.xlsx
!/comparador-dbx/output/test/**/*.xlsx
*.sqlite
*.pkl
models_cache/
frontend/node_modules/

# Manual técnico en PDF: solo uso local, no se publica
Manual_Tecnico_Comparador_Normativo_MVP.pdf

# Los archivos de stage se versionan (solo proveedores, nunca secretos)
!comparador-dbx/config/defaults.env
!comparador-dbx/config/stages/dev.env
!comparador-dbx/config/stages/sandbox.env
!comparador-dbx/config/stages/mvp.env

# Documentos de entrada por zona (docs/14 #26). test = MOCK ficticios y normas públicas; val = documentos REALES de validación.
# documentos/val/ (normas, manuales y comparaciones) NO se versiona nunca. En test solo van en git los MOCK; las normas públicas
# pesan MB y se quedan en local (cámbialo aquí si quieres versionarlas).
/comparador-dbx/documentos/*
!/comparador-dbx/documentos/LEEME.md
!/comparador-dbx/documentos/test/
/comparador-dbx/documentos/test/*
!/comparador-dbx/documentos/test/manuales/
/comparador-dbx/documentos/test/manuales/*
!/comparador-dbx/documentos/test/manuales/MOCK-DEMO-*.pdf
/comparador-dbx/documentos/val/
